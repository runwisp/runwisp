{
  "name": "@runwisp/common",
  "description": "Shared types, constants, and utilities for the RunWisp platform.",
  "type": "module",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/runwisp/runwisp.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/runwisp/runwisp/tree/main/packages/common#readme",
  "bugs": {
    "url": "https://github.com/runwisp/runwisp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo '@runwisp/common: no build step (raw source)'",
    "check": "tsc --noEmit && eslint .",
    "generate:api": "bun run scripts/generate-api.ts"
  },
  "nx": {
    "targets": {
      "build": {
        "cache": true,
        "inputs": [
          "production"
        ],
        "outputs": []
      },
      "generate:api": {
        "dependsOn": [
          "@runwisp/app:openapi"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/apps/runwisp/openapi.json"
        ],
        "outputs": [
          "{projectRoot}/src/generated/api.ts"
        ]
      }
    }
  },
  "dependencies": {
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@runwisp/eslint-config": "workspace:*",
    "@runwisp/typescript-config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.2"
  }
}
