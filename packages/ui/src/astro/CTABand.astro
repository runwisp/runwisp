---
// SPDX-FileCopyrightText: PoppyCake, s.r.o.
// SPDX-License-Identifier: Apache-2.0

interface Props {
    heading: string;
    sub?: string;
    tone?: "default" | "primary";
    class?: string;
}

const { heading, sub, tone = "default", class: className = "" } = Astro.props;

const surface =
    tone === "primary" ? "bg-primary text-on-primary" : "bg-surface-raised text-on-surface";
const subTone = tone === "primary" ? "text-on-primary/80" : "text-on-surface-muted";
const hasCtas = Astro.slots.has("ctas");
---

<section class:list={[className]}>
    <div class="mx-auto max-w-5xl px-6 py-16 sm:py-20">
        <div
            class:list={[
                surface,
                "rounded-[4px] border border-outline px-6 py-12 text-center shadow-sm sm:px-10",
            ]}
        >
            <h2 class="font-mono text-3xl font-extrabold sm:text-4xl">{heading}</h2>
            {sub && <p class:list={[subTone, "mt-4 font-sans text-lg"]}>{sub}</p>}
            {
                hasCtas && (
                    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                        <slot name="ctas" />
                    </div>
                )
            }
        </div>
    </div>
</section>
