{
    "name": "@runwisp/ui",
    "description": "Svelte 5 UI component library for RunWisp dashboards and admin interfaces.",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/runwisp/runwisp.git",
        "directory": "packages/ui"
    },
    "homepage": "https://github.com/runwisp/runwisp/tree/main/packages/ui#readme",
    "bugs": {
        "url": "https://github.com/runwisp/runwisp/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "src"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./src/lib/index.ts",
    "types": "./src/lib/index.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/lib/index.ts",
            "svelte": "./src/lib/index.ts",
            "default": "./src/lib/index.ts"
        },
        "./theme.css": {
            "style": "./src/lib/theme.css",
            "default": "./src/lib/theme.css"
        },
        "./theme-tokens.css": {
            "style": "./src/lib/theme-tokens.css",
            "default": "./src/lib/theme-tokens.css"
        },
        "./src/lib/theme.css": "./src/lib/theme.css",
        "./assets/*": "./src/lib/assets/*",
        "./astro/*": "./src/astro/*",
        "./*": "./src/lib/*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.3",
        "@eslint/compat": "^1.4.1",
        "@eslint/js": "^9.39.5",
        "@runwisp/eslint-config": "workspace:*",
        "@runwisp/typescript-config": "workspace:*",
        "@storybook/addon-a11y": "^10.5.5",
        "@storybook/addon-docs": "^10.5.5",
        "@storybook/addon-svelte-csf": "^5.1.2",
        "@storybook/addon-vitest": "^10.5.5",
        "@storybook/sveltekit": "^10.5.5",
        "@sveltejs/kit": "^2.70.2",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@tailwindcss/vite": "^4.3.3",
        "@types/dlv": "^1.1.5",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.13.3",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-storybook": "^10.5.5",
        "eslint-plugin-svelte": "^3.22.0",
        "globals": "^16.5.0",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "storybook": "^10.5.5",
        "svelte": "^5.56.8",
        "svelte-check": "^4.7.4",
        "tailwindcss": "^4.3.3",
        "typescript": "5.9.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.10"
    },
    "keywords": [
        "svelte",
        "svelte5",
        "ui-components",
        "dashboard",
        "cron",
        "tailwindcss",
        "runwisp"
    ],
    "dependencies": {
        "@floating-ui/dom": "^1.8.0",
        "@fontsource/tasa-orbiter": "^5.3.0",
        "@lucide/svelte": "^0.561.0",
        "@runwisp/common": "workspace:*",
        "@tanstack/svelte-virtual": "^3.13.35",
        "ansi-to-html": "^0.7.2",
        "cron-parser": "^5.7.0",
        "cronstrue": "^3.24.0",
        "date-fns": "^4.4.0",
        "dlv": "^1.1.3",
        "fuse.js": "^7.5.0",
        "ms": "^2.1.3"
    }
}
