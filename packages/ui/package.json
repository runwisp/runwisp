{
    "name": "@runwisp/ui",
    "description": "Svelte 5 UI component library for RunWisp dashboards and admin interfaces.",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/runwisp/runwisp.git",
        "directory": "packages/ui"
    },
    "homepage": "https://github.com/runwisp/runwisp/tree/main/packages/ui#readme",
    "bugs": {
        "url": "https://github.com/runwisp/runwisp/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "storybook dev -p 6006 --no-open",
        "build": "echo '@runwisp/ui: no build step (raw source)'",
        "check": "bun run check:types && bun run check:lint",
        "check:types": "svelte-check --tsconfig ./tsconfig.json",
        "check:lint": "prettier --check . && eslint .",
        "format": "prettier --write ."
    },
    "files": [
        "src"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "svelte": "./src/lib/index.ts",
    "types": "./src/lib/index.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/lib/index.ts",
            "svelte": "./src/lib/index.ts",
            "default": "./src/lib/index.ts"
        },
        "./theme.css": {
            "style": "./src/lib/theme.css",
            "default": "./src/lib/theme.css"
        },
        "./theme-tokens.css": {
            "style": "./src/lib/theme-tokens.css",
            "default": "./src/lib/theme-tokens.css"
        },
        "./src/lib/theme.css": "./src/lib/theme.css",
        "./assets/*": "./src/lib/assets/*",
        "./astro/*": "./src/astro/*",
        "./*": "./src/lib/*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.3",
        "@eslint/compat": "^1.4.0",
        "@eslint/js": "^9.39.1",
        "@runwisp/eslint-config": "workspace:*",
        "@runwisp/typescript-config": "workspace:*",
        "@storybook/addon-a11y": "^10.1.9",
        "@storybook/addon-docs": "^10.1.9",
        "@storybook/addon-svelte-csf": "^5.0.10",
        "@storybook/addon-vitest": "^10.1.9",
        "@storybook/sveltekit": "^10.1.9",
        "@sveltejs/kit": "^2.49.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.17",
        "@types/dlv": "^1.1.5",
        "@types/ms": "^2.1.0",
        "@types/node": "^24",
        "@vitest/browser-playwright": "^4.0.15",
        "@vitest/coverage-v8": "^4.0.15",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.0.0",
        "eslint-plugin-storybook": "^10.1.9",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "playwright": "^1.57.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "storybook": "^10.1.9",
        "svelte": "^5.45.6",
        "svelte-check": "^4.3.4",
        "tailwindcss": "^4.1.17",
        "typescript": "5.9.2",
        "typescript-eslint": "^8.48.1",
        "vite": "^7.2.6",
        "vitest": "^4.0.15"
    },
    "keywords": [
        "svelte",
        "svelte5",
        "ui-components",
        "dashboard",
        "cron",
        "tailwindcss",
        "runwisp"
    ],
    "dependencies": {
        "@floating-ui/dom": "^1.7.4",
        "@fontsource/tasa-orbiter": "^5.2.2",
        "@lucide/svelte": "^0.561.0",
        "@runwisp/common": "workspace:*",
        "@tanstack/svelte-virtual": "^3.13.25",
        "ansi-to-html": "^0.7.2",
        "cron-parser": "^5.4.0",
        "cronstrue": "^3.9.0",
        "date-fns": "^4.1.0",
        "dlv": "^1.1.3",
        "fuse.js": "^7.1.0",
        "ms": "^2.1.3"
    }
}
