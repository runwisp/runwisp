        "maxConcurrent": 1,
        "onOverlap": "skip",
        "restartPolicy": "never",
        "maxRetries": 2,
        "retryDelayMs": 60000,
        "retryBackoff": "exponential",
        "schedules": [
          {
            "cron": "0 3 * * *",
            "timezone": "Europe/Bratislava",
            "enabled": true
          }
        ],
        "jitterMs": 30000,
        "catchUp": "latest",
        "params": {
          "TARGET": {
            "kind": "env",
            "type": "string",
            "required": true,
            "default": "full",
            "choices": [
              "full",
              "schema"
            ],
            "allowCustom": true,
            "description": "What to dump"
          }
        }
      },
