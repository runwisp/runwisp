      {
        "name": "backup",
        "kind": "task",
        "group": "db",
        "description": "Nightly dump",
        "enabled": true,
        "spec": {
          "type": "shell",
          "script": "pg_dump app > /backups/app.sql",
          "shell": "/bin/bash",
          "workingDir": "/srv/app"
