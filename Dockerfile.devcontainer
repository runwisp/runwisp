FROM golang:1.25-bookworm AS golang

FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV BUN_INSTALL=/home/vscode/.bun
ENV NVM_DIR=/usr/local/nvm
ENV NVM_SYMLINK_CURRENT=true
ENV PATH=/home/vscode/.bun/bin:${NVM_DIR}/current/bin:/usr/local/go/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    unzip \
    xz-utils \
    build-essential \
    pkg-config \
    python3 \
 && mkdir -p /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null \
 && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

COPY --from=golang /usr/local/go /usr/local/go
RUN ln -sf /usr/local/go/bin/go /usr/local/bin/go \
 && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt

RUN mkdir -p \
    /home/vscode/.config \
    /home/vscode/.local/share \
    /home/vscode/.local/state \
    /home/vscode/.vscode-server \
 && chown -R vscode:vscode \
    /home/vscode/.config \
    /home/vscode/.local \
    /home/vscode/.vscode-server

RUN mkdir -p "${NVM_DIR}" \
 && curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh \
    | PROFILE=/dev/null bash \
 && bash -lc '. "${NVM_DIR}/nvm.sh" && nvm install --lts && nvm alias default lts/* && nvm use default && corepack enable' \
 && printf '\nexport NVM_DIR=%s\n[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"\n' "${NVM_DIR}" >> /home/vscode/.bashrc \
 && chown -R vscode:vscode "${NVM_DIR}" /home/vscode/.bashrc

USER vscode
RUN curl -fsSL https://bun.sh/install | bash -s -- bun-v1.3.3
RUN bunx playwright install --with-deps
USER root
