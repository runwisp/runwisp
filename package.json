{
  "name": "runwisp",
  "description": "Open-source cron replacement and process supervisor with a built-in web UI. A modern alternative to crond and supervisord.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/runwisp/runwisp.git"
  },
  "homepage": "https://github.com/runwisp/runwisp#readme",
  "bugs": {
    "url": "https://github.com/runwisp/runwisp/issues"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "make dev",
    "build": "make build",
    "build:all": "make build-all",
    "build-dev": "make build-dev",
    "generate": "make generate",
    "check": "make check",
    "format": "make format",
    "theme": "make theme",
    "web-ui": "make web-ui",
    "test": "make test",
    "ci": "make ci"
  },
  "devDependencies": {
    "@astrojs/svelte": "^8.0.0",
    "ajv": "^8.17.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "5.9.2"
  }
}
