// Renders a Web UI screenshot that follows the docs theme: it shows the
// `<name>-light.png` variant in light mode and `<name>-dark.png` in dark mode.
// Both variants are generated by `bun run screenshots` (see
// apps/ui/e2e/screenshots/). Usage in MDX:
//
//   <Screenshot name="web-ui-overview" alt="..." />

import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
    name: string;
    alt: string;
}

const { name, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screenshots/*.png", {
    eager: true,
});

const light = images[`../assets/screenshots/${name}-light.png`]?.default;
const dark = images[`../assets/screenshots/${name}-dark.png`]?.default;

if (!light || !dark) {
    throw new Error(`Screenshot "${name}" is missing a -light.png and/or -dark.png variant`);
}
---

<Image src={light} alt={alt} class="rw-shot rw-shot-light" />
<Image src={dark} alt={alt} class="rw-shot rw-shot-dark" />

<style>
    .rw-shot {
        width: 100%;
        height: auto;
        border-radius: 0.5rem;
        border: 1px solid var(--sl-color-gray-5);
    }
    /* Show the variant matching the active theme. Starlight sets
       data-theme on <html>; default (no attribute) is light. */
    .rw-shot-dark {
        display: none;
    }
    :global([data-theme="dark"]) .rw-shot-light {
        display: none;
    }
    :global([data-theme="dark"]) .rw-shot-dark {
        display: block;
    }
</style>
