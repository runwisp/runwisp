// SPDX-License-Identifier: GPL-3.0-or-later

// Inline the brand mark instead of Starlight's <img>: the SVG is flat
// currentColor, which an <img> can't inherit, so it rendered black in both
// themes. Inlined, it takes --rw-primary like every other RunWisp surface.
import logoSvg from "@runwisp/ui/assets/runwisp-logo.svg?raw";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
    <Fragment set:html={logoSvg} />
    <span translate="no">{siteTitle}</span>
</a>

<style>
    .site-title {
        align-items: center;
        text-decoration: none;
        white-space: nowrap;
        min-width: 0;
    }
    .site-title :global(svg) {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        color: var(--rw-primary);
    }
</style>
