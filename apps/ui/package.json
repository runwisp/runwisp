{
    "name": "@runwisp/web-ui",
    "version": "0.0.0",
    "license": "Apache-2.0",
    "private": true,
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "build-dev": "vite build --mode development",
        "prepare": "bunx @sveltejs/kit sync",
        "check": "bunx @sveltejs/kit sync && bunx svelte-check --tsconfig ./tsconfig.json && bunx prettier --check . && bunx eslint .",
        "format": "prettier --write .",
        "test": "playwright test",
        "test:unit": "vitest run"
    },
    "nx": {
        "targets": {
            "build": {
                "dependsOn": [
                    "^build"
                ],
                "cache": true,
                "inputs": [
                    "production",
                    "^production",
                    "{projectRoot}/.env*"
                ],
                "outputs": [
                    "{projectRoot}/.svelte-kit/**",
                    "{projectRoot}/build/**"
                ]
            },
            "build-dev": {
                "dependsOn": [
                    "^build"
                ],
                "cache": true,
                "inputs": [
                    "default",
                    "^production",
                    "{projectRoot}/.env*"
                ],
                "outputs": [
                    "{projectRoot}/.svelte-kit/**",
                    "{projectRoot}/build/**"
                ]
            },
            "test": {
                "dependsOn": [
                    "@runwisp/app:build-dev"
                ]
            }
        }
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.0",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.52.0",
        "@runwisp/eslint-config": "workspace:*",
        "@runwisp/typescript-config": "workspace:*",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.49.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.17",
        "@types/node": "^24",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-sonarjs": "^4.0.0",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "svelte": "^5.45.6",
        "svelte-check": "^4.3.4",
        "tailwindcss": "^4.1.17",
        "typescript": "5.9.2",
        "typescript-eslint": "^8.48.1",
        "vite": "^7.2.6",
        "vitest": "^4.1.5"
    },
    "dependencies": {
        "@lucide/svelte": "^0.561.0",
        "@runwisp/common": "workspace:*",
        "@runwisp/ui": "workspace:*",
        "@types/event-source-polyfill": "^1.0.5",
        "ansi-to-html": "^0.7.2",
        "event-source-polyfill": "^1.0.31",
        "openapi-fetch": "^0.17.0",
        "zod": "^3.25.76"
    },
    "type": "module"
}
