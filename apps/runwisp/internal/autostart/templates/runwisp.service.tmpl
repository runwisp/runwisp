# Managed by runwisp service install — DO NOT EDIT
# runwisp-config-hash: {{.ConfigHash}}
# runwisp-binary-sha256: {{.BinarySHA}}
{{if .MaskedCronUnit}}# runwisp-masked-cron: {{.MaskedCronUnit}}
{{end}}{{if .CronPriorState}}# runwisp-cron-prior-state: {{.CronPriorState}}
{{end}}[Unit]
Description=RunWisp — lightweight cron daemon
Documentation=https://docs.runwisp.com/
{{if .System}}After=network.target remote-fs.target nss-user-lookup.target time-sync.target{{else}}After=network.target{{end}}
{{- if .CronFailsafeUnit}}
# Cron is masked while RunWisp runs your jobs. If RunWisp keeps failing,
# stop restarting it and hand the jobs back to cron.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure={{.CronFailsafeUnit}}
{{- end}}

[Service]
Type=simple
ExecStart={{.Binary | sysexe}} daemon --config {{.Config | sysq}} --data {{.DataDir | sysq}} --port {{.Port}} --host {{.Host | sysq}}
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
Environment="HOME={{.Home | sysesc}}"
Environment="PATH={{.Path | sysesc}}"
Environment=LANG=C.UTF-8
Environment=RUNWISP_SERVICE_MANAGED=1

[Install]
WantedBy={{if .System}}multi-user.target{{else}}default.target{{end}}
