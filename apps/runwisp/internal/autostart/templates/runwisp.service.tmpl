# Managed by runwisp service install — DO NOT EDIT
# runwisp-config-hash: {{.ConfigHash}}
# runwisp-binary-sha256: {{.BinarySHA}}
{{if .MaskedCronUnit}}# runwisp-masked-cron: {{.MaskedCronUnit}}
{{end}}[Unit]
Description=RunWisp — lightweight cron daemon
Documentation=https://docs.runwisp.com/
{{if .System}}After=network.target remote-fs.target nss-user-lookup.target time-sync.target{{else}}After=network.target{{end}}

[Service]
Type=simple
ExecStart={{.Binary}} daemon --config {{.Config}} --data {{.DataDir}} --port {{.Port}} --host {{.Host}}
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30s
Environment=HOME={{.Home}}
Environment=PATH={{.Path}}
Environment=LANG=C.UTF-8
Environment=RUNWISP_SERVICE_MANAGED=1

[Install]
WantedBy={{if .System}}multi-user.target{{else}}default.target{{end}}
